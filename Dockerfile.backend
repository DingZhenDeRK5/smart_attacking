# 智攻 (SmartAttack) v3.5 — 后端 Docker 镜像
# 基于 Python 3.11 slim，最小化镜像体积
FROM python:3.11-slim

LABEL maintainer="SmartAttack Team"
LABEL description="AI-driven API penetration testing backend engine"
LABEL version="3.5.0"

# 系统依赖（ChromaDB 需要 C++ 运行时，reportlab 需要字体）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# 工作目录
WORKDIR /app

# 安装 Python 依赖（利用 Docker 缓存层）
COPY smart_attacking/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制后端代码
COPY smart_attacking/ ./smart_attacking/

# 创建数据存储目录
RUN mkdir -p /app/smart_attacking/storage/scans

# 暴露端口（Flask + WebSocket）
EXPOSE 8888

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8888/health')" || exit 1

# 启动后端引擎
WORKDIR /app
CMD ["python", "-m", "smart_attacking.scanner"]
