# 智攻 (SmartAttack) Docker 部署环境变量模板
# 复制此文件为 .env 并修改配置

# ---- LLM 模型配置 ----
LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | custom
LLM_API_KEY=sk-your-api-key    # 替换为你的 API Key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=                  # 自定义 OpenAI 兼容端点（仅 custom provider）

# ---- 扫描器配置 ----
SCANNER_FOLLOWUP=true          # 是否启用第二轮精炼攻击
SCANNER_MAX_WORKERS=5          # 并发攻击线程数
FLASK_DEBUG=false              # 生产环境请设为 false
