# ===========================================================================
# SmartAttack v3.1 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ===========================================================================

# ---- LLM 提供者配置 ----
# 支持: deepseek | openai | anthropic | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# 自定义 OpenAI 兼容端点（仅 LLM_PROVIDER=custom 时需要）
# LLM_BASE_URL=http://localhost:11434/v1

# ---- 向后兼容旧配置名（也可用） ----
# DEEPSEEK_API_KEY=sk-your-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 扫描器服务配置 ----
SCANNER_HOST=127.0.0.1
SCANNER_PORT=8888

# ---- 攻击执行参数 ----
SCANNER_HTTP_TIMEOUT=8
SCANNER_MAX_WORKERS=5
SCANNER_FOLLOWUP=true

# ---- 数据库配置 ----
# 默认 SQLite (自动): sqlite:///<project>/storage/smartattack.db
# 切换 PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost/smartattack
# DATABASE_URL=sqlite:///storage/smartattack.db

# ---- 存储路径（可选，仅用于 JSON 迁移） ----
# SCANNER_STORAGE_DIR=/path/to/storage
